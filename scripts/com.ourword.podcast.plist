<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ourword.podcast</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jerryma/Desktop/boke/podcast/scripts/local-daily.sh</string>
  </array>
  <!-- 每天 10:30 跑一次。机器当时是睡着的，launchd 会在唤醒后补跑。 -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/jerryma/Desktop/boke/podcast/.cache/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/jerryma/Desktop/boke/podcast/.cache/logs/launchd.err</string>
  <key>WorkingDirectory</key><string>/Users/jerryma/Desktop/boke/podcast</string>
</dict>
</plist>

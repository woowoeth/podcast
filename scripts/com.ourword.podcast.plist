<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ourword.podcast</string>

  <!-- 工作副本不用桌面上那份：~/Desktop 受 macOS TCC 保护，LaunchAgent 没有应用
       身份，读它只会得到 Operation not permitted——到点静默失败，而且站上不更新
       没人会注意。这份副本自己 clone、自己 pull、自己推，和云端 runner 一个路子。 -->
  <key>WorkingDirectory</key>
  <string>__DIR__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DIR__/scripts/local-daily.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- 本机只跑云端做不到的那批（YouTube 与 Substack）。云端负责其余那些。 -->
    <key>ONLY_RESIDENTIAL</key><string>1</string>
    <key>LIMIT</key><string>6</string>
    <key>DAYS</key><string>21</string>
    <!-- 定时拉起的：由 pipeline/slot.py 判断这一下要不要真跑。手动跑的不判断，只占锁。 -->
    <key>PODCAST_SCHEDULED</key><string>1</string>
  </dict>
  <!-- 每小时 :30 拉一次。正点班次是 10:30 / 21:30（pipeline/slot.py 的 SLOTS）；其余的整点只看
       「最近一班跑成了没有」，跑成了就什么都不做，没成就补。原来只在两个正点起，到点那一下
       没跑成（睡着、关机、重启打断、登录过期、额度用完）就整整等 11 个小时。
       睡着时错过的几次，launchd 在唤醒后合成一次补上。 -->
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>30</integer></dict>
  <!-- 登录时也拉一次（关着机，整点那几下全错过了），同样交给 slot.py 判断。 -->
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key>
  <string>__DIR__/.cache/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/.cache/logs/launchd.err</string>
</dict>
</plist>
